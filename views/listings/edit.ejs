<% layout("/layouts/boilerplate") -%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">

        
            <h3 style="font-color:black">Edit your Listing</h3>
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="for-label">Title</label>
                    <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required/>
                    <div class="valid-feedback">
                        Title looks good.
                    </div>
                </div>
                <div class="mb-3">
                    <label for="description" class="for-label">Description</label>
                    <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
                    <div class="valid-feedback">
                        Description Looks nice.
                    </div>
                    <div class="invalid-feedback">
                        Please write a short description!
                    </div>
                </div>
                <div class="mb-3">
                    Original Listing Image <br>
                   <img src="<%=originalImageUrl%>" class="listing-preview"/>
                   
                </div>
                <div class="mb-3">
                    <label for="image" class="for-label">Upload New Image</label>
                    <input name="listing[image]" type="file" class="form-control"/>
                    
                   
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="for-label">Price</label>
                        <input name="listing[price]" value="<%= listing.price %>" class="form-control" required/>
                        <div class="invalid-feedback">
                            Please provide a resonalble price!
                        </div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="for-label">Country</label>
                        <input
                            name="listing[country]"
                            value="<%= listing.country %>"
                            type="text"
                            class="form-control"
                            required
                        />
                        <div class="valid-feedback">
                        Now country is valid.
                        </div>
                        <div class="invalid-feedback">
                            Please provide correct country name!
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="location" class="for-label">Location</label>
                    <input
                        name="listing[location]"
                        value="<%= listing.location %>"
                        type="text"
                        class="form-control"
                        required
                    />
                    
                    <div class="invalid-feedback">
                        Please provide location to visit!
                    </div>
                </div>
                <button class="btn btn-dark editbtn mt-3">Edit</button>
            </form>
        </div>
    </div>
</body>
