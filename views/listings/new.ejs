<% layout("/layouts/boilerplate") -%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br><br>
            <h3>Create a New Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="for-label">Title</label>
                    <input name="listing[title]" placeholder="Enter title" type="text" class="form-control" required/>
                    <div class="valid-feedback">
                        Title looks good.
                    </div>
                    
                </div>
                <div class="mb-3">
                    <label for="description" class="for-label">Description</label>
                    <textarea
                        name="listing[description]"
                        class="form-control"
                        required
                    ></textarea>
                    <div class="valid-feedback">
                        Description Looks nice.
                    </div>
                    <div class="invalid-feedback">
                        Please write a short description!
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="image" class="for-label">Upload Listing Image</label>
                    <input name="listing[image]" type="file" class="form-control" required/>
                </div>
                <div class="row">   
                    <div class="mb-3 col-md-4">
                        <label for="price" class="for-label">Price</label>
                        <input name="listing[price]" placeholder="Enter price" class="form-control" required/>
                        <div class="valid-feedback">
                            Price is now valid.
                        </div>
                        <div class="invalid-feedback">
                            Price should be valid!
                        </div>
                    </div>
                    
                    <div class="mb-3 col-md-8">
                        <label for="country" class="for-label">Country</label>
                        <input name="listing[country]" placeholder="Enter country" type="text" class="form-control" required/>
                        <div class="valid-feedback">
                            Country is valid now.
                        </div>
                        <div class="invalid-feedback">
                            Country name should be valid!
                        </div>
                    </div>
                </div>
            
                <div class="mb-3">
                    <label for="location" class="for-label">Location</label>
                    <input
                    name="listing[location]"
                    placeholder="Enter location"
                    type="text"
                    class="form-control"
                    required
                />
                <div class="valid-feedback">
                    Now location is correct.
                </div>
                <div class="invalid-feedback">
                    Location should be valid!
                </div>
                </div>
                <button class="btn btn-dark add-btn mt-3">Add</button>
                <br><br>
            </form>
        </div>
    </div>
</body>
