<% layout("/layouts/boilerplate") -%>

<section class="form-shell">
    <div class="form-card form-card-wide">
        <div class="form-heading">
            <span class="eyebrow">Host on TripHaven_ Travel Booking Platform</span>
            <h1>Create a New Listing</h1>
            <p>Show off your space with a polished title, a strong description, and a destination guests will remember.</p>
        </div>

        <form method="POST"
              action="/listings"
              novalidate
              class="needs-validation"
              enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input name="listing[title]"
                       placeholder="Enter title"
                       type="text"
                       class="form-control"
                       required>
                <div class="valid-feedback">Title looks good.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea name="listing[description]"
                          class="form-control"
                          required></textarea>
                <div class="valid-feedback">Description looks nice.</div>
                <div class="invalid-feedback">Please write a short description!</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Upload Listing Image</label>
                <input name="listing[image]"
                       type="file"
                       class="form-control"
                       required>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label class="form-label">Price</label>
                    <input name="listing[price]"
                           placeholder="Enter price"
                           type="number"
                           class="form-control"
                           required>
                    <div class="valid-feedback">Price is valid.</div>
                    <div class="invalid-feedback">Price should be valid!</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label class="form-label">Country</label>
                    <input name="listing[country]"
                           placeholder="Enter country"
                           type="text"
                           class="form-control"
                           required>
                    <div class="valid-feedback">Country is valid.</div>
                    <div class="invalid-feedback">Country name should be valid!</div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Location</label>
                <input name="listing[location]"
                       placeholder="Enter location"
                       type="text"
                       class="form-control"
                       required>
                <div class="valid-feedback">Location looks correct.</div>
                <div class="invalid-feedback">Location should be valid!</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>
                <select name="listing[category]"
                        class="form-control"
                        required>
                    <option value="">Select category</option>
                    <option value="trending">Trending</option>
                    <option value="rooms">Rooms</option>
                    <option value="cities">Iconic Cities</option>
                    <option value="mountains">Mountains</option>
                    <option value="castles">Castles</option>
                    <option value="pools">Amazing Pools</option>
                    <option value="camping">Camping</option>
                    <option value="farms">Farms</option>
                    <option value="arctic">Arctic</option>
                    <option value="domes">Domes</option>
                    <option value="boats">Boats</option>
                </select>
                <div class="invalid-feedback">
                    Please select a category.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Full address</label>
                <input name="listing[address]" class="form-control" placeholder="Street address and nearby landmark">
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label class="form-label">Amenities</label>
                    <input name="listing[amenities]" class="form-control" placeholder="Wi-Fi, pool, parking">
                </div>
                <div class="mb-3 col-md-6">
                    <label class="form-label">Contact information</label>
                    <input name="listing[contact]" type="tel" class="form-control" placeholder="Manager phone number">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Room types</label>
                <textarea name="listing[roomTypes]" class="form-control" placeholder="Deluxe Room:2500:3&#10;Suite:4500:1"></textarea>
                <small class="text-muted">One room per line: Name:price:availability</small>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label class="form-label">Check-in time</label>
                    <input name="listing[checkIn]" type="time" class="form-control">
                </div>
                <div class="mb-3 col-md-6">
                    <label class="form-label">Check-out time</label>
                    <input name="listing[checkOut]" type="time" class="form-control">
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">House rules</label>
                <textarea name="listing[houseRules]" class="form-control" placeholder="No smoking, quiet hours after 10 PM"></textarea>
            </div>

            <button class="btn add-btn mt-3">Add Listing</button>
        </form>
    </div>
</section>
