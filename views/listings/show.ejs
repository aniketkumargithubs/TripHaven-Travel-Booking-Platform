<% layout("/layouts/boilerplate") -%>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<section class="detail-hero">
    <div class="detail-header">
        <div>
            <span class="eyebrow">Stay details</span>
            <h1 class="detail-title"><%= listing.title %></h1>
            <% if (listing.category) { %>
                <a href="/listings?category=<%= listing.category %>" class="detail-category-link">
                    <span class="detail-category-badge">
                        <%= listing.category.charAt(0).toUpperCase() + listing.category.slice(1) %>
                    </span>
                </a>
            <% } %>
        </div>
        <div class="detail-meta-pill">
            <i class="fa-solid fa-location-dot"></i>
            <span><%= listing.location %>, <%= listing.country %></span>
        </div>
    </div>

    <div class="detail-grid">
        <div class="card show-card listing-card detail-card">
            <img
                src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="listing_image"
            >

            <div class="card-body">
                <div class="detail-owner">Hosted by <span>@<%= listing.owner.username %></span></div>
                <% if (listing.contact) { %>
                    <div class="detail-contact mt-3">
                        <strong>Manager contact:</strong>
                        <a href="tel:<%= listing.contact.replace(/[^0-9+]/g, '') %>" class="btn add-btn btn-sm ms-2">
                            <i class="fa-solid fa-phone"></i> Call manager
                        </a>
                        <span class="ms-2"><%= listing.contact %></span>
                    </div>
                <% } %>
                <p class="detail-description"><%= listing.description %></p>
                <% if (listing.address || listing.amenities?.length || listing.checkIn || listing.houseRules) { %>
                    <div class="detail-description">
                        <% if (listing.address) { %><p><strong>Address:</strong> <%= listing.address %></p><% } %>
                        <% if (listing.amenities?.length) { %><p><strong>Amenities:</strong> <%= listing.amenities.join(", ") %></p><% } %>
                        <% if (listing.checkIn || listing.checkOut) { %><p><strong>Timings:</strong> <%= listing.checkIn || "-" %> to <%= listing.checkOut || "-" %></p><% } %>
                        <% if (listing.houseRules) { %><p><strong>House rules:</strong> <%= listing.houseRules %></p><% } %>
                    </div>
                <% } %>

                <div class="detail-highlights">
                    <div class="detail-highlight">
                        <span class="detail-highlight-label">Nightly price</span>
                        <strong>₹ <%= listing.price.toLocaleString("en-IN") %></strong>
                    </div>
                    <div class="detail-highlight">
                        <span class="detail-highlight-label">Location</span>
                        <strong><%= listing.location %></strong>
                    </div>
                    <div class="detail-highlight">
                        <span class="detail-highlight-label">Country</span>
                        <strong><%= listing.country %></strong>
                    </div>
                </div>
            </div>
        </div>

        <aside class="booking-panel">
            <div class="booking-panel-header">
                <span class="eyebrow">Reserve the vibe</span>
                <h3>Designed for easy getaways</h3>
            </div>
            <p>Save this stay, plan your dates, and keep this listing on your radar for the next trip.</p>

            <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
                <div class="btns mt-4">
                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn edit-btn"
                    >
                        Edit listing
                    </a>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                    >
                        <button class="btn dl-btn">Delete</button>
                    </form>
                </div>
            <% } else if (currUser) { %>
                <form method="POST" action="/listings/<%= listing._id %>/book" class="booking-form">
                    <div class="row g-2 mb-3">
                        <div class="col-6"><label class="form-label">Check-in</label><input name="booking[checkIn]" type="date" class="form-control" required></div>
                        <div class="col-6"><label class="form-label">Check-out</label><input name="booking[checkOut]" type="date" class="form-control" required></div>
                    </div>
                    <% if (listing.roomTypes?.length) { %>
                        <label class="form-label">Room type</label>
                        <select name="booking[roomType]" class="form-control mb-3" required>
                            <% listing.roomTypes.forEach((room) => { %><option value="<%= room.name %>"><%= room.name %> - ₹<%= room.price %> (<%= room.availability %> available)</option><% }); %>
                        </select>
                    <% } %>
                    <div class="guest-selector">
                        <button type="button" class="guest-display" id="guestDisplay" aria-expanded="false">
                            <span class="guest-text">1 Adult</span>
                            <span class="guest-arrow" id="guestArrow">▾</span>
                        </button>

                        <div class="guest-panel" id="guestPanel" aria-hidden="true">
                            <div class="guest-row">
                                <div class="guest-label">
                                    <strong>Adults</strong>
                                    <div class="guest-sub">Ages 13+</div>
                                </div>
                                <div class="guest-controls">
                                    <button type="button" class="counter-btn neo decrement" data-target="adults">−</button>
                                    <input id="adults" name="booking[adults]" type="number" value="1" min="1" readonly>
                                    <button type="button" class="counter-btn neo increment" data-target="adults">+</button>
                                </div>
                            </div>

                            <div class="guest-row">
                                <div class="guest-label">
                                    <strong>Children</strong>
                                    <div class="guest-sub">Ages 0–12</div>
                                </div>
                                <div class="guest-controls">
                                    <button type="button" class="counter-btn neo decrement" data-target="children">−</button>
                                    <input id="children" name="booking[children]" type="number" value="0" min="0" readonly>
                                    <button type="button" class="counter-btn neo increment" data-target="children">+</button>
                                </div>
                            </div>

                            <div class="guest-actions">
                                <button type="button" class="btn cancel-guest" id="guestDone">Done</button>
                                <button type="submit" class="btn add-btn reserve-now">Reserve Now</button>
                            </div>
                        </div>
                    </div>
                </form>
            <% } else { %>
                <p class="empty-copy mb-0">Log in to reserve this stay.</p>
            <% } %>
        </aside>
    </div>
</section>

<section class="detail-section">
    <div class="review-panel">
        <% if (currUser) { %>
            <h4>Leave a Review</h4>

            <form
                method="POST"
                action="/listings/<%= listing._id %>/reviews"
                novalidate
                class="needs-validation"
            >
                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="rating1" name="review[rating]" value="1" checked>
                        <label for="rating1" title="1 star"></label>

                        <input type="radio" id="rating2" name="review[rating]" value="2">
                        <label for="rating2" title="2 stars"></label>

                        <input type="radio" id="rating3" name="review[rating]" value="3">
                        <label for="rating3" title="3 stars"></label>

                        <input type="radio" id="rating4" name="review[rating]" value="4">
                        <label for="rating4" title="4 stars"></label>

                        <input type="radio" id="rating5" name="review[rating]" value="5">
                        <label for="rating5" title="5 stars"></label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label class="form-label">Comment</label>
                    <textarea
                        name="review[comment]"
                        rows="5"
                        class="form-control"
                        required
                    ></textarea>
                    <div class="invalid-feedback">
                        Please add some comments for review
                    </div>
                </div>

                <button class="btn add-btn">Submit Review</button>
            </form>
        <% } else { %>
            <h4>Guest Reviews</h4>
            <p class="empty-copy mb-0">Log in to leave a review and share your experience with future travelers.</p>
        <% } %>
    </div>

    <div class="review-list-panel">
        <h4>Guest Reviews</h4>
        <% if (listing.reviews.length > 0) { %>
            <div class="row g-3">
                <% for (let review of listing.reviews) { %>
                    <div class="col-md-6">
                        <div class="card review-card">
                            <div class="card-body">
                                <h5>@<%= review.author.username %></h5>

                                <p class="starability-result"
                                   data-rating="<%= review.rating %>"></p>

                                <p><%= review.comment %></p>

                                <% if (currUser && currUser._id.equals(review.author._id)) { %>
                                    <form
                                        method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    >
                                        <button class="btn btn-sm dl-btn">
                                            Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <p class="empty-copy mb-0">No reviews yet. Be the first to share what made this stay memorable.</p>
        <% } %>
    </div>
</section>

<section class="map-panel">
    <h3>Where you will be</h3>
    <div id="map"></div>
</section>

<script src="/js/map.js"></script>
<script src="/js/booking.js"></script>
