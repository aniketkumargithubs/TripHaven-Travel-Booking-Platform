<% layout("/layouts/boilerplate") -%>

<section class="form-shell">
    <div class="form-card">
        <div class="form-heading">
            <span class="eyebrow">Welcome back</span>
            <h1>Log In</h1>
            <p>Pick up where you left off and keep exploring beautiful stays around the world.</p>
        </div>

        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="for-label">Username</label>
                <input name="username" placeholder="Enter your username" id="username" type="text" class="form-control" required/>
                <div class="valid-feedback">
                    Looks good.
                </div>
            </div>

            <div class="mb-3">
                <label for="password" class="for-label">Password</label>
                <input name="password" placeholder="Enter password" id="password" type="password" class="form-control" required/>
            </div>

            <button class="btn add-btn w-100">Login</button>
        </form>
    </div>
</section>
